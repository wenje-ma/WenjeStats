   "source": [
    "# 图 2.3\n",
    "\n",
    "options(repr.plot.width=15,repr.plot.height=5)\n",
    "par(mfrow=c(1,3))\n",
    "f=function(x) sin(10*pi*x)/(1+64*(x-.25)^2)+x^2\n",
    "test=seq(0,1,length=301)\n",
    "true=f(test)\n",
    "n=10\n",
    "D=((1:n)-1)/(n-1)\n",
    "y=f(D)\n",
    "E=abs(outer(D,D,\"-\"))\n",
    "\n",
    "## 左\n",
    "\n",
    "theta=.01\n",
    "R=exp(-(E/theta)^2)\n",
    "coef=solve(R,y)\n",
    "R_pred=exp(-(outer(test,D,\"-\")/theta)^2)\n",
    "pred=R_pred%*%coef \n",
    "plot(test,true,type=\"l\",lwd=3,lty=2,xlab=\"x\",ylab=\"y\",ylim=c(min(true)-.25,max(true)+.25),main=expression(theta==0.01),cex.main=2)\n",
    "points(cbind(D,y),pch=16,cex=2,col=\"blue\")\n",
    "lines(test,pred,col=3,lwd=3)\n",
    "\n",
    "## 中\n",
    "\n",
    "theta=.1\n",
    "R=exp(-(E/theta)^2)\n",
    "coef=solve(R,y)\n",
    "R_pred=exp(-(outer(test,D,\"-\")/theta)^2)\n",
    "pred=R_pred%*%coef \n",
    "plot(test,true,type=\"l\",lwd=3,lty=2,xlab=\"x\",ylab=\"y\",ylim=c(min(true)-.25,max(true)+.25),main=expression(theta==0.01),cex.main=2)\n",
    "points(cbind(D,y),pch=16,cex=2,col=\"blue\")\n",
    "lines(test,pred,col=3,lwd=3)\n",
    "\n",
    "## 右\n",
    "\n",
    "theta=1\n",
    "R=exp(-(E/theta)^2)\n",
    "coef=solve(R,y)\n",
    "R_pred=exp(-(outer(test,D,\"-\")/theta)^2)\n",
    "pred=R_pred%*%coef \n",
    "plot(test,true,type=\"l\",lwd=3,lty=2,xlab=\"x\",ylab=\"y\",ylim=c(min(true)-.25,max(true)+.25),main=expression(theta==0.01),cex.main=2)\n",
    "points(cbind(D,y),pch=16,cex=2,col=\"blue\")\n",
    "lines(test,pred,col=3,lwd=3)\n",
    "\n",
    "legend(\"bottomright\",legend=c(\"truth\",\"prediction\"),lty=c(2,1),col=c(1,3),lwd=c(2,3),bty=\"n\")\n",
    "par(mfrow=c(1,1))"
